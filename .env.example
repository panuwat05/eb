// คำอธิบายไฟล์: ตัวอย่างชื่อตัวแปรแวดล้อมที่โครงการต้องใช้ โดยค่าที่แสดงเป็น placeholder ไม่ใช่ข้อมูลลับจริง
# ใช้ SQLite สำหรับพัฒนา หากเปลี่ยนเป็น MySQL ให้แก้ provider ใน prisma/schema.prisma และกำหนด DATABASE_URL ให้ตรงกับฐานข้อมูล
DATABASE_URL="file:./dev.db"
# สร้างค่านี้ด้วยคำสั่ง npx auth secret หรือ openssl rand -base64 32
AUTH_SECRET="replace-me"
# สคริปต์ seed ใช้ค่านี้สร้างบัญชีผู้ดูแลระบบคนแรก
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
# Optional: seed development sample data (never use in production)
SEED_SAMPLE="false"
SEED_USER_PASSWORD=""

# การเข้าสู่ระบบ KKUMail ผ่าน Google OAuth เว้นว่างไว้หากไม่ต้องการเปิดใช้
# Callback URL ที่ต้องลงทะเบียนใน Google: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
KKU_EMAIL_DOMAIN="kkumail.com"

# GitHub OAuth เป็นทางเลือก โดยอีเมลต้องตรงกับบัญชีที่มีอยู่ในฐานข้อมูล
# Callback URL ที่ต้องลงทะเบียนใน GitHub: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
